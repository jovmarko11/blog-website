---
/**
 * BaseLayout — the shell of every page:
 * <head> (meta, fonts, global CSS, theme before paint) → NavBar → <main> → StatusBar.
 */
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

import NavBar from "../components/layout/NavBar.astro";
import StatusBar from "../components/layout/StatusBar.astro";
import CommandPalette from "../components/layout/CommandPalette.astro";
import { site } from "../config/site";
import { getProjects } from "../lib/projects";

interface Props {
  /** Page title; the site title is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Keep the page out of search engines (e.g. the style guide). */
  noindex?: boolean;
  statusError?: string;
  /** Social preview image (path under public/), 1200×630. */
  image?: string;
}

const { title, description = site.description, noindex = false, statusError, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const projectCount = (await getProjects()).length;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0c0d10" />

    <!-- social previews (Open Graph + Twitter/X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Apply the saved theme before first paint (no flash). Dark is the default. -->
    <script is:inline>
      document.documentElement.classList.add("js"); // enables entrance animations (content stays visible without JS)
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>

  <body>
    <div class="screen">
      <div class="shell"><NavBar /></div>
      <main id="main">
        <slot />
      </main>
      <div class="shell shell--bottom"><StatusBar projects={projectCount} error={statusError} /></div>
    </div>
    <CommandPalette />
  </body>
</html>

<style>
  .shell { padding: 16px 24px 0; }
  .shell--bottom { padding: 48px 24px 16px; }
  @container screen (max-width: 640px) {
    .shell { padding: 12px 12px 0; }
    .shell--bottom { padding: 32px 0 0; }
  }
</style>
