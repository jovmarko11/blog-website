---
/**
 * NavBar — main navigation as IDE tabs. Items come from config/site.ts.
 * The tab matching the current URL is active (accent underline).
 */
import Logo from "../brand/Logo.astro";
import Kbd from "../ui/Kbd.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { nav, site } from "../../config/site";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<nav class="nav" aria-label="Main">
  <a class="nav__brand" href="/" aria-label={`${site.name}, home`}><Logo variant="path" /></a>
  <ul class="nav__tabs" role="list">
    {nav.map((item) => (
      <li>
        <a class:list={["nav__tab", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}<span class="nav__ext">{item.ext}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="nav__right">
    <span class="nav__kbd"><Kbd>⌘K</Kbd></span>
    <ThemeToggle />
    <a class="nav__ext-link" href={site.links.github} rel="noopener">github ↗</a>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-family: var(--font-mono);
    font-size: 13px;
    overflow: hidden;
  }
  .nav__brand { display: flex; align-items: center; padding: 0 16px; border-right: 1px solid var(--line); }
  .nav__tabs { display: flex; margin: 0; }
  .nav__tab {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 12px 16px;
    color: var(--ink-muted);
    border-right: 1px solid var(--line);
    transition: color 0.12s, background 0.12s;
  }
  .nav__tab:hover { color: var(--ink); background: var(--surface-raised); }
  .nav__tab.is-active { color: var(--ink); background: var(--bg); box-shadow: inset 0 -2px 0 var(--accent); }
  .nav__ext { color: var(--ink-faint); }
  .nav__right { margin-left: auto; display: flex; align-items: center; gap: 12px; padding: 0 16px; }
  .nav__ext-link { color: var(--ink-faint); }
  .nav__ext-link:hover { color: var(--ink); }

  @container screen (max-width: 640px) {
    .nav { overflow-x: auto; scrollbar-width: none; font-size: 12px; }
    .nav__brand, .nav__tab { padding-inline: 12px; }
    .nav__ext, .nav__kbd, .nav__ext-link { display: none; }
    .nav__right { padding: 0 8px; }
  }
</style>
