---
/** Kbd — a keyboard key hint, e.g. <Kbd>⌘K</Kbd>. */
---

<kbd class="kbd"><slot /></kbd>

<style>
  .kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
    padding: 1px 6px;
    border-radius: var(--radius-s);
    border: 1px solid var(--control-border);
    color: var(--ink-muted);
  }
</style>
