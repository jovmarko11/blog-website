---
/**
 * Button — mono, command-style actions. Renders <a> when `href` is set, else <button>.
 *   <Button href="/projects/">→ view projects</Button>
 *   <Button variant="ghost" href={site.links.github}>github</Button>
 *   <Button variant="link" href="...">read the write-up <span data-arrow>→</span></Button>
 * One primary button per screen.
 */
import type { HTMLAttributes } from "astro/types";

type Props = {
  variant?: "primary" | "ghost" | "link";
  href?: string;
} & HTMLAttributes<"a"> & HTMLAttributes<"button">;

const { variant = "primary", href, class: className, ...rest } = Astro.props;
const Element = href ? "a" : "button";
---

<Element href={href} class:list={["btn", `btn--${variant}`, className]} {...rest}>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-s);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--on-accent);
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }
  .btn--primary:hover { background: var(--accent-strong); border-color: var(--accent-strong); color: var(--on-accent); }

  .btn--ghost { background: transparent; border-color: var(--control-border); color: var(--ink); }
  .btn--ghost:hover { background: var(--surface-raised); border-color: var(--ink-muted); color: var(--ink); }

  .btn--link { background: none; border-color: transparent; color: var(--accent); padding-inline: 0; }
  .btn--link:hover { color: var(--accent-strong); }
  .btn--link :global([data-arrow]) { transition: transform 0.15s; }
  .btn--link:hover :global([data-arrow]) { transform: translateX(4px); }
</style>
