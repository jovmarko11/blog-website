---
/**
 * Venn — software ∩ AI ∩ math, with the fields I'd like to bring in around it.
 * The circles draw themselves when scrolled into view (parent must have data-reveal).
 */
const circles = [
  { cx: 150, cy: 110, label: "software", lx: 92, ly: 78 },
  { cx: 230, cy: 110, label: "AI", lx: 268, ly: 78 },
  { cx: 190, cy: 175, label: "math", lx: 190, ly: 236 },
];
const outer = [
  { x: 24, y: 196, t: "physics" },
  { x: 356, y: 196, t: "biology", end: true },
  { x: 356, y: 30, t: "economics", end: true },
];
---

<svg class="venn" viewBox="0 0 380 260" role="img" aria-label="Where software, AI and mathematics overlap, with physics, biology and economics around them.">
  {circles.map((c, i) => (
    <>
      <circle class="venn__c" cx={c.cx} cy={c.cy} r="72" pathLength="1" style={`--i:${i}`} />
      <text class="venn__l" x={c.lx} y={c.ly} text-anchor="middle" style={`--i:${i}`}>{c.label}</text>
    </>
  ))}
  <circle class="venn__here" cx="190" cy="134" r="5" />
  <text class="venn__here-t" x="190" y="122" text-anchor="middle">here</text>
  {outer.map((o, i) => <text class="venn__o" x={o.x} y={o.y} text-anchor={o.end ? "end" : "start"} style={`--i:${i}`}>+ {o.t}</text>)}
</svg>

<style>
  .venn { display: block; width: 100%; max-width: 420px; height: auto; overflow: visible; }
  .venn__c { fill: color-mix(in srgb, var(--accent) 6%, transparent); stroke: var(--control-border); stroke-width: 1.5; }
  .venn__l { fill: var(--ink); font-family: var(--font-mono); font-size: 13px; font-weight: 700; }
  .venn__here { fill: var(--accent); }
  .venn__here-t { fill: var(--accent); font-family: var(--font-mono); font-size: 11px; font-weight: 700; }
  .venn__o { fill: var(--ink-faint); font-family: var(--font-mono); font-size: 12px; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .venn__c { stroke-dasharray: 1; stroke-dashoffset: 1; }
    :global(.js) .venn__l, :global(.js) .venn__o, :global(.js) .venn__here, :global(.js) .venn__here-t { opacity: 0; }
    :global(.js .is-in) .venn__c { animation: vdraw 1.1s cubic-bezier(0.5, 0, 0.3, 1) calc(var(--i) * 0.25s) forwards; }
    :global(.js .is-in) .venn__l { animation: vfade 0.5s ease calc(var(--i) * 0.25s + 0.6s) forwards; }
    :global(.js .is-in) .venn__here, :global(.js .is-in) .venn__here-t { animation: vfade 0.5s ease 1.4s forwards; }
    :global(.js .is-in) .venn__o { animation: vfade 0.5s ease calc(var(--i) * 0.15s + 1.7s) forwards; }
  }
  @keyframes vdraw { to { stroke-dashoffset: 0; } }
  @keyframes vfade { to { opacity: 1; } }
</style>
