---
/**
 * GitLog — the story as `git log --reverse --graph`.
 * The graph line fills in as the reader scrolls; each commit lights up when reached.
 * Ends with HEAD → "This site".
 */
import type { LogEntry } from "../../data/about";

interface Props { entries: LogEntry[]; }
const { entries } = Astro.props;

/** Deterministic 7-char "commit hash" from the title (FNV-1a), purely decorative. */
const hash = (s: string) => {
  let h = 0x811c9dc5;
  for (const c of s) { h ^= c.charCodeAt(0); h = Math.imul(h, 0x01000193) >>> 0; }
  return h.toString(16).padStart(8, "0").slice(0, 7);
};
---

<ol class="log" role="list" data-gitlog>
  {entries.map((e) => (
    <li class:list={["commit", { "commit--running": e.running }]} data-commit>
      <span class="commit__dot" aria-hidden="true"></span>
      <div class="commit__meta"><span class="commit__hash" data-hash>{hash(e.title)}</span><span class="commit__when">{e.when}</span><span class="commit__kind">{e.kind}</span>{e.running && <span class="commit__run">● still running</span>}</div>
      <h3 class="commit__title">{e.title}</h3>
      <p class="commit__body" set:html={e.body} />
    </li>
  ))}
  <li class="commit commit--head" data-commit>
    <span class="commit__dot" aria-hidden="true"></span>
    <div class="commit__meta"><span class="commit__hash" data-hash>{hash("HEAD this site")}</span><span class="commit__when">HEAD → main</span><span class="commit__kind">now</span></div>
    <h3 class="commit__title">This site<span class="commit__cursor" aria-hidden="true"></span></h3>
    <p class="commit__body">Every project gets a write-up: the idea, the math, the code and the mistakes.</p>
  </li>
</ol>

<script>
  import { initScrollProgress, scramble } from "../../scripts/motion";
  document.querySelectorAll<HTMLElement>("[data-gitlog]").forEach((el) =>
    initScrollProgress(el, "[data-commit]", (item) => {
      const h = item.querySelector<HTMLElement>("[data-hash]");
      if (h) scramble(h);
    }),
  );
</script>

<style>
  .log { position: relative; padding: 0 0 0 8px; --progress: 1; }
  /* track + scroll-linked fill */
  .log::before, .log::after { content: ""; position: absolute; left: 12px; top: 8px; bottom: 18px; width: 2px; }
  .log::before { background: var(--line-strong); }
  .log::after { background: var(--accent); transform-origin: top; transform: scaleY(var(--progress)); }
  :global(html:not(.js)) .log::after { transform: scaleY(1); }

  .commit { position: relative; padding: 0 0 36px 36px; }
  .commit__dot { position: absolute; left: 0; top: 3px; z-index: 1; width: 10px; height: 10px; border-radius: 50%; background: var(--bg); border: 2px solid var(--control-border); transition: border-color 0.3s, background 0.3s, box-shadow 0.3s; }
  .commit__meta { display: flex; gap: 12px; font-family: var(--font-mono); font-size: 12px; line-height: 16px; }
  .commit__hash { color: var(--ink-faint); opacity: 0.8; font-variant-numeric: tabular-nums; }
  .commit__when { color: var(--ink-faint); font-weight: 700; transition: color 0.3s; }
  .commit__kind { color: var(--ink-faint); }
  .commit__run { margin-left: auto; color: var(--accent); }
  .commit__title { margin-top: 6px; font-size: 20px; line-height: 28px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
  .commit__body { margin-top: 8px; font-size: 17px; line-height: 28px; color: var(--ink-muted); max-width: 72ch; }
  .commit__body :global(em) { color: var(--ink); font-style: italic; }
  .commit__body :global(a) { text-decoration: underline; text-underline-offset: 3px; }

  /* lit = reached by the reader (always lit without JS) */
  .commit:global(.is-lit) .commit__dot, :global(html:not(.js)) .commit__dot { border-color: var(--accent); }
  .commit:global(.is-lit) .commit__when, :global(html:not(.js)) .commit__when { color: var(--accent); }
  .commit--running:global(.is-lit) .commit__dot { background: var(--accent); }
  .commit--head { padding-bottom: 0; }
  .commit--head:global(.is-lit) .commit__dot { background: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
  .commit__cursor { display: inline-block; width: 0.5em; height: 0.9em; margin-left: 6px; vertical-align: -0.1em; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .commit__title, :global(.js) .commit__body { opacity: 0.32; transform: translateX(-6px); transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); }
    :global(.js) .commit:global(.is-lit) .commit__title, :global(.js) .commit:global(.is-lit) .commit__body { opacity: 1; transform: none; }
    :global(.js) .commit:global(.is-lit) .commit__dot { animation: ping 0.6s ease-out; }
  }
  @container screen (max-width: 640px) {
    .commit { padding-left: 30px; }
    .commit__title { font-size: 18px; line-height: 26px; }
    .commit__body { font-size: 16px; line-height: 26px; }
    .commit__run, .commit__hash { display: none; }
  }
</style>
