---
/**
 * Hero — the landing: a man page (left) and the project map (right).
 * Both halves show ONE selection: the <argument> in SYNOPSIS, the lit point, the crosshair
 * with its readouts, the card and the category flag all follow the same project.
 *
 * Motion (JS only): the command types itself, the page prints line by line, the axes draw,
 * points appear, then an automatic tour moves through the featured projects. The first hover,
 * focus or tap on a point hands control to the visitor. Without JS or with reduced motion
 * everything is visible at once and the first featured project is selected.
 */
import type { CollectionEntry } from "astro:content";
import Kbd from "../ui/Kbd.astro";
import { site } from "../../config/site";
import { hero } from "../../data/home";
import { MAP, AXIS_Y, toMap, labelSide, GUIDES, placeCard, type Mark } from "../../lib/project-map";

interface Props {
  /** Every published project (newest first). Featured ones make the tour. */
  projects: CollectionEntry<"projects">[];
}
const { projects } = Astro.props;

const points = projects.map((p, i) => {
  const d = p.data;
  return {
    id: p.id,
    i,
    ...toMap(d.plot),
    px: d.plot.x,
    py: d.plot.y,
    title: d.title,
    meta: [...d.stack.slice(0, 2), d.course?.code ?? d.category].join(" · "),
    hue: d.hue,
    category: d.category,
    side: labelSide(d.plot.x),
  };
});
const tour = points.filter((p) => projects[p.i].data.featured).map((p) => p.id);
const first = points.find((p) => p.id === tour[0]) ?? points[0];
const nextPt = toMap(hero.next);

const f1 = (n: number) => n.toFixed(1);
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
// everything a card could cover: every point with its label, and the "next" mark
const marks: (Mark & { id: string })[] = [
  ...points.map((p) => ({ id: p.id, x: p.x, y: p.y, label: p.id, side: p.side })),
  { id: "next", x: nextPt.x, y: nextPt.y, label: hero.next.label, side: "left" as const },
];
const cardSide = (p: typeof first) => placeCard(p, marks.filter((m) => m.id !== p.id));
const nameLines = site.name.split(" ");
---

<section class="hx paper" data-hero data-tour={tour.join(",")} data-selected={first.id} data-tour-seconds={hero.tourSeconds} aria-label="Introduction">
  <div class="wrap hx__inner">
    <div class="hx__bar">
      <span class="hx__prompt"><span class="hx__sign" aria-hidden="true">$</span> <span class="hx__cmd" data-cmd>{hero.command}</span><span class="hx__cmdcur" aria-hidden="true"></span></span>
      <span class="hx__manual">Portfolio Manual</span>
      <span>{site.handle.toUpperCase()}(1)</span>
    </div>

    <div class="hx__grid">
      <!-- ============ the man page ============ -->
      <div class="hx__man">
        <p class="hx__dt r" style="--i:0">NAME</p>
        <h1 class="hx__name r" style="--i:1">
          {nameLines.map((w, i) => <>{i > 0 && <br />}{w}</>)}<span class="hx__cursor" aria-hidden="true"></span>
        </h1>
        <p class="hx__what r" style="--i:2">{hero.tagline}</p>

        <p class="hx__dt r" style="--i:3">SYNOPSIS</p>
        <p class="hx__syn r" style="--i:4">
          <b>{site.handle}</b>{" "}
          {hero.flags.map((f) => (
            <>[<a class:list={["hx__flag", { "is-on": f === first.category }]} data-flag={f} href={`/projects/?category=${f}`}>--{f}</a>]{" "}</>
          ))}
          <span class="hx__arg">&lt;<span data-arg>{first.id}</span>&gt;</span>
        </p>

        <p class="hx__dt r" style="--i:5">OPTIONS</p>
        <nav class="hx__opts r" style="--i:6" aria-label="Sections">
          {hero.options.map((o, n) => (
            <a data-opt class:list={{ "is-sel": n === 0 }} href={o.href}>
              <b>{o.flag}</b><span>{o.text}</span><i aria-hidden="true">↵</i>
            </a>
          ))}
        </nav>
      </div>

      <!-- ============ the project map ============ -->
      <figure class="hx__map r" style="--i:2">
        <svg viewBox={`0 0 ${MAP.w} ${MAP.h}`} role="group" aria-label="Projects plotted by abstraction (metal to models) and theory depth">
          <g class="hx-guides" aria-hidden="true">
            {GUIDES.map((g) => {
              const a = toMap({ x: g, y: g });
              return <><line x1={f1(a.x)} y1={MAP.y0} x2={f1(a.x)} y2={AXIS_Y} /><line x1={MAP.x0} y1={f1(a.y)} x2={MAP.x0 + MAP.pw} y2={f1(a.y)} /></>;
            })}
          </g>

          <g aria-hidden="true">
            <path class="hx-axis" pathLength="1" d={`M${MAP.x0} ${MAP.y0 - 8} V${AXIS_Y} H${MAP.x0 + MAP.pw + 14}`} />
            <path class="hx-head" d={`M${MAP.x0 + MAP.pw + 20} ${AXIS_Y} l-8 -4 v8z`} />
            <path class="hx-head" d={`M${MAP.x0} ${MAP.y0 - 14} l-4 8 h8z`} />
            <text class="hx-tick" x={MAP.x0} y={AXIS_Y + 18}>metal</text>
            <text class="hx-tick" x={MAP.x0 + MAP.pw} y={AXIS_Y + 18} text-anchor="end">models</text>
            <text class="hx-ax" x={MAP.x0 + MAP.pw / 2} y={AXIS_Y + 42} text-anchor="middle">abstraction →</text>
            <text class="hx-ax hx-ax--y" transform={`translate(16 ${MAP.y0 + MAP.ph / 2}) rotate(-90)`} text-anchor="middle">theory depth →</text>
          </g>

          <!-- where the next projects will land -->
          <g class="hx-next" data-next data-x={f1(nextPt.x)} data-y={f1(nextPt.y)} data-label={hero.next.label} transform={`translate(${f1(nextPt.x)} ${f1(nextPt.y)})`} aria-hidden="true">
            <circle r="7" />
            <text x="-14" y="4" text-anchor="end">{hero.next.label}</text>
          </g>

          <g class="hx-cross" aria-hidden="true">
            <line data-cv x1={f1(first.x)} y1={f1(first.y)} x2={f1(first.x)} y2={AXIS_Y} />
            <line data-ch x1={MAP.x0} y1={f1(first.y)} x2={f1(first.x)} y2={f1(first.y)} />
            <text data-tx class="hx-tick hx-acc" x={f1(first.x)} y={AXIS_Y + 18} text-anchor="middle">{first.px.toFixed(2)}</text>
            <text data-ty class="hx-tick hx-acc" x={MAP.x0 - 8} y={f1(first.y + 4)} text-anchor="end">{first.py.toFixed(2)}</text>
          </g>

          {points.map((p, n) => (
            <a
              class:list={["hp", { "is-hot": p.id === first.id }]}
              href={`/projects/${p.id}/`}
              style={`--c: var(--hue-${p.hue}); --n:${n}`}
              data-id={p.id} data-x={f1(p.x)} data-y={f1(p.y)} data-px={p.px} data-py={p.py}
              data-title={p.title} data-meta={p.meta} data-hue={p.hue} data-cat={p.category}
              aria-label={`${p.title} (abstraction ${p.px.toFixed(2)}, theory ${p.py.toFixed(2)})`}
            >
              <g transform={`translate(${f1(p.x)} ${f1(p.y)})`}>
                <circle class="hp__hit" r="16" />
                <circle class="hp__ring" r="11" />
                <circle class="hp__dot" r="5" />
                <text x={p.side === "right" ? 12 : -12} y="4" text-anchor={p.side === "right" ? "start" : "end"}>{p.id}</text>
              </g>
            </a>
          ))}
        </svg>

        <a
          class="hx__card"
          data-card
          data-h={cardSide(first).h}
          data-v={cardSide(first).v}
          href={`/projects/${first.id}/`}
          style={`left:${pct(first.x, MAP.w)}; top:${pct(first.y, MAP.h)}; --c: var(--hue-${first.hue})`}
        >
          <span class="hx__card-path">~/projects/<b data-card-slug>{first.id}</b></span>
          <b class="hx__card-title" data-card-title>{first.title}</b>
          <span class="hx__card-meta" data-card-meta>{first.meta}</span>
          <span class="hx__card-go">read →</span>
        </a>
      </figure>
    </div>

    <div class="hx__foot">
      <span class="hx__less">Manual page {site.handle}(1) · project <span data-pos>1/{points.length}</span></span>
      <span class="hx__keys"><Kbd>j</Kbd> <Kbd>k</Kbd> move · <Kbd>↵</Kbd> open · <Kbd>q</Kbd> read on · hover a point</span>
      <span class="hx__xy" data-readout>abstraction {first.px.toFixed(2)} · theory {first.py.toFixed(2)}</span>
    </div>
  </div>
</section>

<script>
  import { initHero } from "../../scripts/hero";
  const root = document.querySelector<HTMLElement>("[data-hero]");
  if (root) initHero(root);
</script>

<style>
  .hx { border-block: 1px solid var(--line); overflow: hidden; }
  .hx__inner { padding-block: 22px 20px; font-family: var(--font-mono); }

  /* ---------- top bar ---------- */
  .hx__bar { display: flex; justify-content: space-between; gap: 16px; font-size: 13px; color: var(--ink-faint); letter-spacing: 0.06em; }
  .hx__prompt { color: var(--ink); letter-spacing: 0; }
  .hx__sign { color: var(--accent); }
  .hx__cmdcur { display: none; width: 0.55em; height: 1em; margin-left: 2px; vertical-align: -0.15em; background: var(--accent); }

  .hx__grid { display: grid; grid-template-columns: minmax(0, 1fr) 580px; gap: 32px; align-items: center; margin-top: 24px; }

  /* ---------- man page ---------- */
  .hx__man p { margin: 0; }
  .hx__dt { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; color: var(--accent); margin: 24px 0 8px !important; }
  .hx__dt:first-child { margin-top: 0 !important; }
  .hx__name { font-family: var(--font-sans); font-size: 68px; line-height: 0.98; font-weight: 800; letter-spacing: -0.04em; margin: 0; color: var(--ink); }
  .hx__cursor { display: inline-block; width: 0.42em; height: 0.76em; margin-left: 0.1em; vertical-align: -0.02em; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hx__what { font-size: 13px; line-height: 20px; color: var(--ink-muted); margin-top: 14px !important; max-width: 46ch; }

  .hx__syn { font-size: 15px; line-height: 24px; color: var(--ink-faint); }
  .hx__syn b { color: var(--ink); }
  .hx__flag { color: var(--accent); padding: 0 2px; border-radius: 2px; transition: background 0.2s, color 0.2s; }
  .hx__flag:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hx__flag.is-on { background: var(--accent-soft); color: var(--accent-strong); }
  .hx__arg { color: var(--ink); white-space: nowrap; }
  .hx__arg [data-arg] { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--accent); }

  .hx__opts { display: flex; flex-direction: column; border-top: 1px dashed var(--line-strong); max-width: 470px; }
  .hx__opts a { position: relative; display: grid; grid-template-columns: 104px 1fr 18px; gap: 12px; min-height: var(--touch-target); align-items: center; padding: 0 6px 0 24px; border-bottom: 1px dashed var(--line-strong); font-size: 13px; color: var(--ink-muted); transition: background 0.15s; }
  .hx__opts a::before { content: "›"; position: absolute; left: 8px; top: 50%; transform: translate(-4px, -50%); color: var(--accent); opacity: 0; transition: opacity 0.15s, transform 0.15s; }
  .hx__opts b { color: var(--ink); font-weight: 600; }
  .hx__opts span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hx__opts i { font-style: normal; color: var(--ink-faint); text-align: right; }
  .hx__opts a.is-sel { background: var(--accent-soft); }
  .hx__opts a.is-sel::before { opacity: 1; transform: translate(0, -50%); }
  .hx__opts a.is-sel b, .hx__opts a.is-sel i { color: var(--accent-strong); }

  /* ---------- map ---------- */
  .hx__map { position: relative; margin: 0; }
  .hx__map svg { display: block; width: 100%; height: auto; overflow: visible; }
  .hx-guides line { stroke: var(--line); stroke-dasharray: 1 5; }
  .hx-axis { stroke: var(--control-border); fill: none; }
  .hx-head { fill: var(--control-border); }
  .hx-tick { fill: var(--ink-faint); font-family: var(--font-mono); font-size: 11px; }
  .hx-acc { fill: var(--accent); }
  .hx-ax { fill: var(--ink-muted); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; }
  .hx-cross line { stroke: var(--accent); stroke-dasharray: 3 4; }

  .hx-next circle { fill: none; stroke: var(--ink-faint); stroke-dasharray: 2 3; animation: breathe 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .hx-next text { fill: var(--ink-faint); font-family: var(--font-mono); font-size: 11px; }
  @keyframes breathe { 50% { opacity: 0.35; transform: scale(0.8); } }

  .hp { outline: none; cursor: pointer; }
  .hp__hit { fill: transparent; }
  .hp__ring { fill: none; stroke: var(--c); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .hp__dot { fill: var(--ink-muted); stroke: var(--bg); stroke-width: 2; transition: fill 0.2s; }
  .hp text { fill: var(--ink-faint); font-family: var(--font-mono); font-size: 11px; transition: fill 0.2s, opacity 0.2s; }
  .hp:hover .hp__dot, .hp:focus-visible .hp__dot { fill: var(--c); }
  .hp:hover text, .hp:focus-visible text { fill: var(--ink); }
  .hp:focus-visible .hp__ring { opacity: 1; }
  .hp.is-hot .hp__dot { fill: var(--c); }
  .hp.is-hot .hp__ring { animation: ping 2.4s ease-out infinite; }
  .hp.is-hot text { opacity: 0; }
  @keyframes ping { 0% { opacity: 0.9; transform: scale(0.5); } 80%, 100% { opacity: 0; transform: scale(1.6); } }

  /* the card follows the selected point; its corner sits 16px from the dot */
  .hx__card {
    position: absolute; z-index: 1; width: 240px;
    display: flex; flex-direction: column; gap: 3px;
    padding: 10px 12px 10px 14px;
    background: var(--surface-raised);
    border: 1px solid var(--line-strong); border-left: 2px solid var(--c);
    border-radius: var(--radius-m);
    color: inherit;
    transition: left 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.2s;
  }
  .hx__card[data-h="r"][data-v="d"] { transform: translate(16px, 16px); }
  .hx__card[data-h="r"][data-v="u"] { transform: translate(16px, calc(-100% - 16px)); }
  .hx__card[data-h="l"][data-v="d"] { transform: translate(calc(-100% - 16px), 16px); }
  .hx__card[data-h="l"][data-v="u"] { transform: translate(calc(-100% - 16px), calc(-100% - 16px)); }
  .hx__card-path { font-size: 11px; color: var(--ink-faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hx__card-path b { font-weight: 500; color: var(--c); }
  .hx__card-title { font-family: var(--font-sans); font-size: 15px; line-height: 20px; font-weight: 700; color: var(--ink); }
  .hx__card-meta { font-size: 11px; color: var(--ink-muted); }
  .hx__card-go { font-size: 11px; color: var(--accent); transition: transform 0.15s; }
  .hx__card:hover { border-color: var(--accent); border-left-color: var(--c); }
  .hx__card:hover .hx__card-go { transform: translateX(4px); }

  /* ---------- less status line ---------- */
  .hx__foot { display: flex; align-items: center; gap: 20px; margin-top: 24px; font-size: 12px; color: var(--ink-faint); }
  .hx__less { background: var(--ink); color: var(--bg); padding: 3px 8px; }
  .hx__xy { margin-left: auto; color: var(--accent); }

  /* ---------- intro motion (JS + motion allowed only) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hx:not(.is-typing):not(.is-on) .hx__cmd { opacity: 0; }
    :global(.js) .hx.is-typing .hx__cmdcur { display: inline-block; }

    :global(.js) .hx .r { opacity: 0; transform: translateY(6px); transition: opacity 0.5s ease, transform 0.5s ease; transition-delay: calc(var(--i) * 80ms); }
    :global(.js) .hx.is-on .r { opacity: 1; transform: none; }

    :global(.js) .hx .hx-axis { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.25s; }
    :global(.js) .hx.is-on .hx-axis { stroke-dashoffset: 0; }
    :global(.js) .hx .hx-head, :global(.js) .hx .hx-guides, :global(.js) .hx .hx-tick, :global(.js) .hx .hx-ax, :global(.js) .hx .hx-next { opacity: 0; transition: opacity 0.6s ease 1.1s; }
    :global(.js) .hx.is-on .hx-head, :global(.js) .hx.is-on .hx-guides, :global(.js) .hx.is-on .hx-tick, :global(.js) .hx.is-on .hx-ax, :global(.js) .hx.is-on .hx-next { opacity: 1; }

    :global(.js) .hx .hp g { opacity: 0; transform-box: fill-box; transition: opacity 0.4s ease, scale 0.5s cubic-bezier(0.3, 1.6, 0.5, 1); scale: 0.2; transform-origin: center; transition-delay: calc(1s + var(--n) * 120ms); }
    :global(.js) .hx.is-on .hp g { opacity: 1; scale: 1; }

    :global(.js) .hx .hx-cross, :global(.js) .hx .hx__card { opacity: 0; }
    :global(.js) .hx.is-on .hx-cross { opacity: 1; transition: opacity 0.5s ease 1.7s; }
    :global(.js) .hx.is-on .hx__card { opacity: 1; transition: opacity 0.5s ease 1.8s, left 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), top 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.52s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.2s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx__cursor, .hx-next circle, .hp.is-hot .hp__ring { animation: none; }
    .hx__card { transition: none; }
  }

  /* ---------- tablet: map under the man page ---------- */
  @container screen (max-width: 900px) {
    .hx__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .hx__map { max-width: 620px; }
  }

  /* ---------- phone ---------- */
  @container screen (max-width: 640px) {
    .hx__inner { padding-block: 16px 20px; }
    .hx__manual { display: none; }
    .hx__name { font-size: 46px; }
    .hx__what { font-size: 12px; }
    .hx__syn { font-size: 14px; line-height: 22px; }
    .hx__opts { max-width: none; }
    .hx__opts a { grid-template-columns: 92px 1fr 14px; font-size: 12px; }
    .hx-tick { font-size: 17px; }
    .hx-ax { font-size: 18px; }
    .hx-next text, .hp text, .hx-cross text, .hx-ax--y { display: none; }
    .hp__dot { r: 9px; }
    .hp__ring { r: 18px; }
    .hp__hit { r: 26px; }
    /* on a phone the card is a normal block under the map */
    .hx__card, .hx__card[data-h][data-v] { position: static; width: auto; transform: none; margin-top: 12px; }
    .hx__foot { flex-wrap: wrap; gap: 8px; }
    .hx__keys { display: none; }
    .hx__xy { margin-left: 0; font-size: 11px; }
    .hx__less { font-size: 11px; }
  }
</style>
