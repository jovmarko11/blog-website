---
/**
 * Cursor — the blinking block cursor ▮, the brand's only permanent animation.
 * Sizes itself to the surrounding font-size. Decorative: hidden from screen readers.
 */
interface Props {
  /** Stop blinking (e.g. for static contexts). */
  still?: boolean;
}
const { still = false } = Astro.props;
---

<span class:list={["cursor", { "cursor--still": still }]} aria-hidden="true"></span>

<style>
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.08em;
    vertical-align: -0.18em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  .cursor--still { animation: none; }
  @keyframes blink { 50% { opacity: 0; } }
</style>
