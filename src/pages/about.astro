---
/**
 * /about — the story, not the CV. One column like a blog post.
 * Text lives in src/data/about.ts; motion helpers in src/scripts/motion.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalHeading from "../components/ui/TerminalHeading.astro";
import Label from "../components/ui/Label.astro";
import Tag from "../components/ui/Tag.astro";
import Trajectory from "../components/about/Trajectory.astro";
import NowGrid from "../components/about/NowGrid.astro";
import GitLog from "../components/about/GitLog.astro";
import Venn from "../components/about/Venn.astro";
import { now, log, earlier, toolbox } from "../data/about";
import { site } from "../config/site";

const contacts = [
  { key: "email", value: site.links.email.replace("mailto:", ""), href: site.links.email },
  { key: "github", value: "jovmarko11 ↗", href: site.links.github },
  { key: "linkedin", value: "Marko Jovanović ↗", href: site.links.linkedin },
  { key: "cv", value: "cv.pdf ↓", href: site.links.cv },
].filter((c) => c.href);
---

<BaseLayout title="About" description="How someone who came for physics stayed for software, and where he's heading next.">
  <!-- ============ header ============ -->
  <header class="head paper">
    <div class="wrap head__grid">
      <div>
        <TerminalHeading cmd="cat" arg="about.md" />
        <h1 class="head__title">About<span class="head__cursor" aria-hidden="true"></span></h1>
        <p class="head__lede">How someone who came for physics stayed for software, and where he's heading next.</p>
      </div>
      <Trajectory />
    </div>
  </header>

  <article class="wrap wrap--narrow story">
    <!-- ============ intro ============ -->
    <section class="intro" data-reveal>
      <p class="intro__lead">I'm Marko. I study Software Engineering in Belgrade, and I like building things <span class="hl">from first principles</span> (shells, renderers, neural networks) until I understand why they work.</p>
      <p>I didn't set out to be a programmer. I was the kid who liked physics and math, and code was just the tool for running simulations. This page is the story of how <span class="hl">the tool became the subject</span>.</p>
    </section>

    <!-- ============ now ============ -->
    <section class="block">
      <div data-reveal><Label index="01 —">Now</Label></div>
      <NowGrid items={now} />
    </section>

    <!-- ============ story ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="02 —">How I got here</Label>
        <h2 class="block__title">From a flock of birds to a parser in five layers</h2>
        <p class="block__cmd t-prompt"><span>$</span> git log --reverse --graph</p>
      </div>
      <GitLog entries={log} />
    </section>

    <!-- ============ direction ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="03 —">Where I'm going</Label>
        <h2 class="block__title">Between fields, on purpose</h2>
      </div>
      <div class="direction">
        <div data-reveal>
          <p>I don't want to pick just one field. The problems I find most interesting sit where <strong>software</strong>, <strong>AI</strong> and <strong>mathematics</strong> overlap, and they only get better when physics, biology or economics join in.</p>
          <p>Concretely: I want to do <span class="hl">research in artificial intelligence</span>, understand how models actually work, and build AI systems with the same care as good software, with a lot of math holding it all together.</p>
        </div>
        <div class="direction__venn" data-reveal style="--d: 150ms"><Venn /></div>
      </div>
    </section>

    <!-- ============ earlier work ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="04 —">Before this site</Label>
        <h2 class="block__title">First research, 2024</h2>
      </div>
      <ul class="earlier" role="list">
        {earlier.map((e, i) => (
          <li data-reveal style={`--d:${i * 90}ms`}>
            <span class="earlier__where">{e.where}</span>
            <span class="earlier__title">{e.title}</span>
            <span class="earlier__text">{e.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============ toolbox ============ -->
    <section class="block">
      <div data-reveal><Label index="05 —">Toolbox</Label></div>
      <div class="tools">
        {toolbox.map((row, r) => (
          <div class="tools__row" data-reveal style={`--d:${r * 80}ms`}>
            <span class="tools__key">{row.key}</span>
            <div class="tools__items">{row.items.map((t) => <Tag variant={row.solid ? "solid" : "default"}>{t}</Tag>)}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ contact ============ -->
    <section class="block block--last">
      <div data-reveal>
        <Label index="06 —">Say hi</Label>
        <h2 class="block__title">Talk to me about a parser, a simulation or a paper you liked.</h2>
      </div>
      <div class="contact">
        {contacts.map((c, i) => (
          <a href={c.href} rel="noopener" data-reveal style={`--d:${i * 80}ms`}><span>{c.key}</span><b>{c.value}</b></a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  import { initReveal } from "../scripts/motion";
  initReveal();
</script>

<style>
  /* header */
  .head { border-block: 1px solid var(--line); overflow: hidden; }
  .head__grid { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 48px; align-items: center; padding-block: 56px 40px; }
  .head__title { margin-top: 6px; font-size: 56px; line-height: 60px; font-weight: 800; letter-spacing: -0.035em; }
  .head__cursor { display: inline-block; width: 0.4em; height: 0.75em; margin-left: 0.1em; vertical-align: -0.02em; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .head__lede { margin-top: 12px; max-width: 44ch; font-size: 18px; line-height: 30px; color: var(--ink-muted); }

  /* story column */
  .story { padding-top: 48px; }
  .intro p { font-size: 19px; line-height: 32px; color: var(--ink-muted); }
  .intro p + p { margin-top: 16px; }
  .intro .intro__lead { font-size: 22px; line-height: 35px; color: var(--ink); }

  .block { margin-top: 72px; }
  .block--last { padding-bottom: 24px; }
  .block :global(.label) { margin-bottom: 14px; }
  .block__title { font-size: 28px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em; margin: -4px 0 8px; }
  .block__cmd { color: var(--ink-muted); margin-bottom: 24px; }
  .block__cmd span { color: var(--accent); margin-right: 0.5em; }

  .direction { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 32px; align-items: center; margin-top: 12px; }
  .direction p { font-size: 18px; line-height: 30px; color: var(--ink-muted); }
  .direction p + p { margin-top: 14px; }
  .direction strong { color: var(--ink); font-weight: 600; }

  .earlier { display: flex; flex-direction: column; border-top: 1px solid var(--line); margin-top: 8px; }
  .earlier li { display: grid; grid-template-columns: 190px 1fr; column-gap: 20px; row-gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .earlier__where { grid-row: span 2; font-family: var(--font-mono); font-size: 12px; line-height: 22px; color: var(--accent); }
  .earlier__title { font-weight: 700; color: var(--ink); }
  .earlier__text { font-size: 15px; line-height: 23px; color: var(--ink-muted); }

  .tools { display: flex; flex-direction: column; gap: 12px; }
  .tools__row { display: grid; grid-template-columns: 100px 1fr; gap: 16px; align-items: baseline; }
  .tools__key { font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); }
  .tools__items { display: flex; flex-wrap: wrap; gap: 6px; }

  .contact { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 20px; }
  .contact a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); transition: border-color 0.15s; }
  .contact a:hover { border-color: var(--accent); }
  .contact a:hover b { color: var(--accent); }
  .contact span { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }
  .contact b { font-family: var(--font-mono); font-size: 14px; font-weight: 500; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color 0.15s; }

  @container screen (max-width: 900px) {
    .head__grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .head__grid > :global(.traj) { max-width: 420px; }
    .direction { grid-template-columns: 1fr; }
    .direction__venn { max-width: 340px; }
  }
  @container screen (max-width: 640px) {
    .head__title { font-size: 40px; line-height: 44px; }
    .intro .intro__lead { font-size: 19px; line-height: 30px; }
    .intro p, .direction p { font-size: 17px; line-height: 28px; }
    .block { margin-top: 56px; }
    .block__title { font-size: 23px; line-height: 30px; }
    .earlier li { grid-template-columns: 1fr; }
    .earlier__where { grid-row: auto; }
    .tools__row { grid-template-columns: 1fr; gap: 6px; }
    .contact { grid-template-columns: 1fr; }
  }
</style>
