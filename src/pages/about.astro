---
/**
 * /about — the story, not the CV. One wide reading column.
 * Text lives in src/data/about.ts; motion helpers in src/scripts/motion.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalHeading from "../components/ui/TerminalHeading.astro";
import Label from "../components/ui/Label.astro";
import Tag from "../components/ui/Tag.astro";
import Trajectory3D from "../components/about/Trajectory3D.astro";
import NowGrid from "../components/about/NowGrid.astro";
import GitLog from "../components/about/GitLog.astro";
import Venn from "../components/about/Venn.astro";
import ContactCTA from "../components/about/ContactCTA.astro";
import { now, log, earlier, toolbox, lead, numbers, quote } from "../data/about";

// split the lead into words so they can be revealed one by one
let w = 0;
const leadWords = lead.map((part) => ({ hl: part.hl, words: part.t.split(" ").map((t) => ({ t, i: w++ })) }));
---

<BaseLayout title="About" description="How someone who came for physics stayed for software, and where he's heading next.">
  <!-- ============ header ============ -->
  <header class="head paper">
    <div class="wrap head__grid">
      <div class="head__text">
        <TerminalHeading cmd="cat" arg="about.md" />
        <h1 class="head__title">About<span class="head__cursor" aria-hidden="true"></span></h1>
        <p class="head__lede">How someone who came for physics stayed for software, and where he's heading next.</p>
        <p class="head__hint t-meta"><span class="head__dot"></span>my path in 3D: code · math &amp; physics · time</p>
      </div>
      <Trajectory3D />
    </div>
  </header>

  <article class="wrap story">
    <!-- ============ intro ============ -->
    <section class="intro" data-reveal>
      <p class="intro__lead">
        {leadWords.map((part) => (
          <span class:list={{ hl: part.hl }}>{part.words.map((x) => <><span class="w" style={`--w:${x.i}`}>{x.t}</span>{" "}</>)}</span>
        ))}
      </p>
      <p class="intro__p">I didn't set out to be a programmer. I was the kid who liked physics and math, and code was just the tool for running simulations. This page is the story of how <span class="hl">the tool became the subject</span>.</p>
    </section>

    <!-- ============ numbers ============ -->
    <ul class="nums" role="list">
      {numbers.map((x, i) => (
        <li data-reveal style={`--d:${i * 90}ms`}>
          <span class="nums__n">{x.n !== undefined ? <><span data-count={x.n}>{x.n}</span>{x.suffix}</> : x.text}</span>
          <span class="nums__l">{x.label}</span>
        </li>
      ))}
    </ul>

    <!-- ============ now ============ -->
    <section class="block">
      <div data-reveal><Label index="01 —">Now</Label></div>
      <NowGrid items={now} />
    </section>

    <!-- ============ story ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="02 —">How I got here</Label>
        <h2 class="block__title">From a flock of birds to a parser in five layers</h2>
        <p class="block__cmd t-prompt"><span>$</span>git log --reverse --graph</p>
      </div>
      <GitLog entries={log} />
    </section>

    <!-- ============ quote ============ -->
    <figure class="quote" data-reveal>
      <blockquote><span class="quote__mark" aria-hidden="true">“</span><span class="hl">{quote}</span></blockquote>
      <figcaption class="t-meta">— the one thing Petnica taught me that every course since has confirmed</figcaption>
    </figure>

    <!-- ============ direction ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="03 —">Where I'm going</Label>
        <h2 class="block__title">Between fields, on purpose</h2>
      </div>
      <div class="direction">
        <div data-reveal>
          <p>I don't want to pick just one field. The problems I find most interesting sit where <strong>software</strong>, <strong>AI</strong> and <strong>mathematics</strong> overlap, and they only get better when physics, biology or economics join in.</p>
          <p>Concretely: I want to do <span class="hl">research in artificial intelligence</span>, understand how models actually work, and build AI systems with the same care as good software, with a lot of math holding it all together.</p>
        </div>
        <div class="direction__venn" data-reveal style="--d: 150ms"><Venn /></div>
      </div>
    </section>

    <!-- ============ earlier work ============ -->
    <section class="block">
      <div data-reveal>
        <Label index="04 —">Before this site</Label>
        <h2 class="block__title">First research, 2024</h2>
      </div>
      <ul class="earlier" role="list">
        {earlier.map((e, i) => (
          <li data-reveal style={`--d:${i * 90}ms`}>
            <span class="earlier__where">{e.where}</span>
            <div class="earlier__main">
              <span class="earlier__title">{e.title}</span>
              <span class="earlier__text">{e.text}</span>
              <span class="earlier__tags">{e.tags.map((t) => <Tag>{t}</Tag>)}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============ toolbox ============ -->
    <section class="block">
      <div data-reveal><Label index="05 —">Toolbox</Label></div>
      <div class="tools">
        {toolbox.map((row, r) => (
          <div class="tools__row" data-reveal style={`--d:${r * 80}ms`}>
            <span class="tools__key">{row.key}</span>
            <div class="tools__items">{row.items.map((t, i) => <span class="tools__item" style={`--t:${i}`}><Tag variant={row.solid ? "solid" : "default"}>{t}</Tag></span>)}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ contact ============ -->
    <ContactCTA />
  </article>
</BaseLayout>

<script>
  import { initReveal, initCountUp } from "../scripts/motion";
  initReveal();
  initCountUp();
</script>

<style>
  /* ---------- header ---------- */
  .head { border-block: 1px solid var(--line); overflow: hidden; }
  .head__grid { display: grid; grid-template-columns: minmax(0, 1fr) 460px; gap: 40px; align-items: center; padding-block: 48px 32px; }
  .head__title { margin-top: 6px; font-size: 56px; line-height: 60px; font-weight: 800; letter-spacing: -0.035em; }
  .head__cursor { display: inline-block; width: 0.4em; height: 0.75em; margin-left: 0.1em; vertical-align: -0.02em; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .head__lede { margin-top: 12px; max-width: 44ch; font-size: 18px; line-height: 30px; color: var(--ink-muted); }
  .head__hint { display: flex; align-items: center; gap: 8px; margin-top: 20px; color: var(--ink-faint); }
  .head__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  /* ---------- reading column: wider than articles ---------- */
  .story { max-width: calc(920px + 2 * var(--space-5)); padding-top: 56px; }

  .intro__lead { font-size: 24px; line-height: 38px; color: var(--ink); letter-spacing: -0.005em; }
  .intro__p { margin-top: 18px; font-size: 19px; line-height: 32px; color: var(--ink-muted); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .intro .w { display: inline-block; opacity: 0; filter: blur(4px); transform: translateY(6px); transition: opacity 0.5s ease, filter 0.5s ease, transform 0.5s ease; transition-delay: calc(var(--w) * 28ms); }
    :global(.js) .intro:global(.is-in) .w { opacity: 1; filter: none; transform: none; }
    :global(.js) .intro .intro__p { opacity: 0; transition: opacity 0.6s ease 0.9s; }
    :global(.js) .intro:global(.is-in) .intro__p { opacity: 1; }
  }

  .nums { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 44px; border-block: 1px solid var(--line); }
  .nums li { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px 18px 0; }
  .nums li + li { padding-left: 20px; border-left: 1px dashed var(--line-strong); }
  .nums__n { font-size: 34px; line-height: 38px; font-weight: 800; letter-spacing: -0.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .nums__l { font-family: var(--font-mono); font-size: 12px; line-height: 18px; color: var(--ink-faint); }

  .block { margin-top: 80px; }
  .block :global(.label) { margin-bottom: 14px; }
  .block__title { font-size: 30px; line-height: 38px; font-weight: 700; letter-spacing: -0.02em; margin: -4px 0 8px; }
  .block__cmd { color: var(--ink-muted); margin-bottom: 28px; }
  .block__cmd span { color: var(--accent); margin-right: 0.6em; }

  /* pull quote */
  .quote { margin: 80px 0 0; padding: 36px 0 32px; border-block: 1px solid var(--line); text-align: center; }
  .quote blockquote { margin: 0; font-size: 34px; line-height: 44px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  .quote__mark { display: block; height: 36px; font-size: 72px; line-height: 72px; color: var(--accent); font-family: var(--font-mono); }
  .quote figcaption { margin-top: 14px; color: var(--ink-faint); }

  .direction { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 32px; align-items: center; margin-top: 12px; }
  .direction p { font-size: 18px; line-height: 30px; color: var(--ink-muted); }
  .direction p + p { margin-top: 14px; }
  .direction strong { color: var(--ink); font-weight: 600; }

  .earlier { display: flex; flex-direction: column; border-top: 1px solid var(--line); margin-top: 8px; }
  .earlier li { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--line); transition: background 0.2s; }
  .earlier li:hover { background: linear-gradient(90deg, var(--surface), transparent); }
  .earlier__where { font-family: var(--font-mono); font-size: 12px; line-height: 22px; color: var(--accent); }
  .earlier__main { display: flex; flex-direction: column; gap: 6px; }
  .earlier__title { font-size: 17px; font-weight: 700; color: var(--ink); }
  .earlier__text { font-size: 16px; line-height: 25px; color: var(--ink-muted); }
  .earlier__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }

  .tools { display: flex; flex-direction: column; gap: 14px; }
  .tools__row { display: grid; grid-template-columns: 110px 1fr; gap: 16px; align-items: baseline; }
  .tools__key { font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint); }
  .tools__items { display: flex; flex-wrap: wrap; gap: 6px; }
  .tools__item { display: inline-flex; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tools__item { opacity: 0; transform: translateY(6px) scale(0.96); transition: opacity 0.35s ease, transform 0.35s ease; transition-delay: calc(var(--d, 0ms) + var(--t) * 45ms + 150ms); }
    :global(.js) .tools__row:global(.is-in) .tools__item { opacity: 1; transform: none; }
  }

  /* ---------- responsive ---------- */
  @container screen (max-width: 900px) {
    .head__grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .direction { grid-template-columns: 1fr; }
    .direction__venn { max-width: 380px; }
    .nums { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nums li:nth-child(3) { padding-left: 0; border-left: 0; }
    .nums li:nth-child(n + 3) { border-top: 1px dashed var(--line-strong); }
  }
  @container screen (max-width: 640px) {
    .head__title { font-size: 40px; line-height: 44px; }
    .intro__lead { font-size: 20px; line-height: 31px; }
    .intro__p, .direction p { font-size: 17px; line-height: 28px; }
    .nums__n { font-size: 28px; line-height: 32px; }
    .block { margin-top: 60px; }
    .block__title { font-size: 24px; line-height: 31px; }
    .quote blockquote { font-size: 24px; line-height: 32px; }
    .earlier li { grid-template-columns: 1fr; gap: 6px; }
    .tools__row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
