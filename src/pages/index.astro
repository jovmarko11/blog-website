---
/**
 * Home — the man-page hero with the project map, the featured projects,
 * and how a project write-up is organised. Text lives in src/data/home.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import WriteupAnatomy from "../components/home/WriteupAnatomy.astro";
import { getProjects } from "../lib/projects";
import { anatomy } from "../data/home";

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const example = projects.find((p) => p.id === anatomy.exampleSlug);
---

<BaseLayout>
  <Hero projects={projects} />
  <FeaturedProjects projects={featured} total={projects.length} />
  <WriteupAnatomy example={example} />
</BaseLayout>

<script>
  import { initReveal } from "../scripts/motion";
  initReveal();
</script>
